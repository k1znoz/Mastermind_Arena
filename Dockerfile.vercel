FROM maven:3.9-eclipse-temurin-21 AS build
WORKDIR /src
COPY pom.xml ./
COPY deduction-engine/pom.xml deduction-engine/pom.xml
COPY deduction-engine/src deduction-engine/src
RUN mvn -q -pl deduction-engine -am -DskipTests package dependency:copy-dependencies -DincludeScope=runtime

FROM eclipse-temurin:21-jre
WORKDIR /app
COPY --from=build /src/deduction-engine/target/classes /app/classes
COPY --from=build /src/deduction-engine/target/dependency /app/lib
CMD ["sh", "-c", "APP_HTTP_PORT=${PORT:-80} exec java -cp '/app/classes:/app/lib/*' io.mastermindarena.deduction.api.submitaction.LocalSubmitActionHttpServerMain"]