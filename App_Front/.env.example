# Copy to .env.local and set VITE_API_KEY to the same value as APP_API_KEY.
VITE_API_BASE_URL=
VITE_PROXY_TARGET=http://localhost:8081
VITE_MATCH_STATE_PATH=/api/local/match-state
VITE_SUBMIT_ACTION_PATH=/api/local/submit-action
VITE_API_KEY_HEADER=X-API-Key
VITE_API_KEY=replace-with-your-own-strong-api-key
VITE_REQUEST_ID_HEADER=X-Request-Id
VITE_MATCH_ID=local-match
VITE_ACTOR_ID=p1
