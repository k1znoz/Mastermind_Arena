{
    "$schema":  "https://openapi.vercel.sh/vercel.json",
    "services":  {
                     "backend":  {
                                     "root":  ".",
                                     "runtime":  "container"
                                 }
                 },
    "rewrites":  [
                     {
                         "source":  "/(.*)",
                         "destination":  {
                                             "service":  "backend"
                                         }
                     }
                 ]
}
