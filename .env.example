# =========================
# Mastermind Arena - Local/Dev Environment
# =========================

# --- HTTP runtime ---
APP_HTTP_HOST=0.0.0.0
APP_HTTP_PORT=8080

# --- API security (P6-A) ---
# Header read by server (default: X-API-Key)
APP_API_KEY_HEADER=X-API-Key
# Never commit real value
APP_API_KEY=change-me-dev-key

# --- Database (P6-B Supabase/Postgres via JDBC) ---
# IMPORTANT:
# - Keep sslmode=require for Supabase
# - Do not commit real credentials
APP_DB_URL=jdbc:postgresql://db.<PROJECT_REF>.supabase.co:5432/postgres?sslmode=require
APP_DB_USER=postgres
APP_DB_PASSWORD=change-me-db-password
APP_DB_SCHEMA=public

# --- Logging / observability ---
APP_LOG_LEVEL=INFO
# Optional request correlation header name
APP_REQUEST_ID_HEADER=X-Request-Id

# --- CORS (browser access control) ---
# Comma-separated origin whitelist (no trailing slash), example:
# APP_CORS_ALLOWED_ORIGINS=http://localhost:5173,https://your-front-domain.com
APP_CORS_ALLOWED_ORIGINS=http://localhost:5173
APP_CORS_ALLOWED_METHODS=GET,POST,OPTIONS
APP_CORS_ALLOWED_HEADERS=Content-Type,X-API-Key,X-Request-Id
APP_CORS_MAX_AGE_SECONDS=600

VITE_API_BASE_URL=https://mastermind-arena.onrender.com